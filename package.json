{
  "name": "andamio",
  "version": "1.0.0",
  "description": "Andamio: builds de Minecraft (.litematic) capa por capa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit && eslint . && prettier --check . && vitest run",
    "ejemplo": "node scripts/generar-ejemplo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.1.0",
    "@fontsource-variable/geist-mono": "^5.1.0",
    "@phosphor-icons/core": "^2.1.1",
    "jszip": "3.10.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@types/node": "^22.8.1",
    "@types/three": "0.169.0",
    "eslint": "9.13.0",
    "globals": "15.11.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
